<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Panda Pages – Professionelles Webdesign für lokale Unternehmen</title>
  <meta name="description" content="Panda Pages – Moderne, mobiloptimierte und SEO-optimierte Websites für lokale Unternehmen in NRW. Fertig in 7 Tagen, ab 490 €." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
 
    :root {
      --black:   #000000;
      --white:   #ffffff;
      --gray-50: #f5f5f7;
      --gray-100:#e8e8ed;
      --gray-300:#b0b0b8;
      --gray-500:#6e6e73;
      --gray-700:#3a3a3c;
      --gray-900:#1d1d1f;
      --accent:  #2D6A4F;
      --accent2: #52B788;
      --accent-light: rgba(45,106,79,0.08);
      --ff: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --radius: 18px;
      --transition: 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
 
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--ff);
      background: var(--white);
      color: var(--gray-900);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
 
    /* ── COOKIE BANNER ── */
    #cookie-banner {
      position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
      z-index: 9999; width: min(560px, calc(100vw - 32px));
      background: rgba(29,29,31,0.92);
      backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 20px; padding: 20px 24px;
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; flex-wrap: wrap;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    #cookie-banner p { font-size: 0.825rem; color: rgba(255,255,255,0.75); line-height: 1.5; flex: 1; min-width: 200px; }
    #cookie-banner a { color: var(--accent2); text-decoration: none; }
    .cookie-actions { display: flex; gap: 8px; flex-shrink: 0; }
    .cookie-accept {
      background: var(--accent); color: #fff;
      border: none; border-radius: 100px;
      padding: 0.5rem 1.2rem; font-size: 0.825rem; font-weight: 500;
      font-family: var(--ff); cursor: pointer;
      transition: background 0.2s;
    }
    .cookie-accept:hover { background: #245c42; }
    .cookie-decline {
      background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.7);
      border: 1px solid rgba(255,255,255,0.15); border-radius: 100px;
      padding: 0.5rem 1.2rem; font-size: 0.825rem; font-weight: 500;
      font-family: var(--ff); cursor: pointer;
      transition: background 0.2s;
    }
    .cookie-decline:hover { background: rgba(255,255,255,0.15); }
 
    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      height: 52px;
      background: rgba(255,255,255,0.72);
      backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid rgba(0,0,0,0.08);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 max(24px, 4vw);
      transition: background 0.3s;
    }
    .nav-logo {
      display: flex; align-items: center; gap: 8px;
      text-decoration: none;
    }
    .nav-logo img { width: 28px; height: 28px; object-fit: contain; }
    .nav-logo span {
      font-size: 1rem; font-weight: 600; color: var(--gray-900);
      letter-spacing: -0.02em;
    }
    .nav-links { display: flex; gap: 0; list-style: none; }
    .nav-links a {
      font-size: 0.8rem; font-weight: 400; color: var(--gray-500);
      text-decoration: none; padding: 0.4rem 0.9rem;
      border-radius: 100px;
      transition: color 0.2s, background 0.2s;
    }
    .nav-links a:hover { color: var(--gray-900); background: var(--gray-50); }
    .nav-cta {
      background: var(--gray-900); color: #fff;
      padding: 0.45rem 1.1rem; border-radius: 100px;
      font-size: 0.8rem; font-weight: 500;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
    }
    .nav-cta:hover { background: var(--gray-700); transform: scale(1.02); }
 
    /* ── SECTIONS BASE ── */
    section { padding: clamp(80px, 10vw, 120px) max(24px, 5vw); }
    .label {
      font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--accent);
      margin-bottom: 12px;
    }
    h1, h2, h3 { letter-spacing: -0.03em; line-height: 1.1; }
    h2 {
      font-size: clamp(2rem, 4vw, 3.2rem);
      font-weight: 600; color: var(--gray-900);
      margin-bottom: 16px;
    }
    .subtitle {
      font-size: clamp(1rem, 2vw, 1.2rem);
      color: var(--gray-500); font-weight: 400; line-height: 1.6;
      max-width: 580px;
    }
 
    /* ── HERO ── */
    #hero {
      min-height: 100vh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center;
      padding: 120px max(24px, 5vw) 80px;
      position: relative; overflow: hidden;
      background: var(--white);
    }
    .hero-glow {
      position: absolute; width: 800px; height: 800px;
      background: radial-gradient(ellipse, rgba(82,183,136,0.12) 0%, transparent 70%);
      top: 50%; left: 50%; transform: translate(-50%, -50%);
      pointer-events: none;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--gray-50); border: 1px solid var(--gray-100);
      color: var(--gray-500); padding: 0.4rem 1rem;
      border-radius: 100px; font-size: 0.78rem; font-weight: 500;
      margin-bottom: 28px; position: relative; z-index: 1;
    }
    .hero-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent2); }
    h1 {
      font-size: clamp(3rem, 8vw, 6.5rem);
      font-weight: 600; color: var(--gray-900);
      line-height: 1.05; max-width: 900px;
      position: relative; z-index: 1;
      margin-bottom: 24px;
    }
    h1 .accent { color: var(--accent); }
    .hero-sub {
      font-size: clamp(1rem, 2vw, 1.25rem);
      color: var(--gray-500); max-width: 540px;
      line-height: 1.65; margin-bottom: 40px;
      position: relative; z-index: 1;
    }
    .hero-actions {
      display: flex; gap: 12px; flex-wrap: wrap;
      justify-content: center; position: relative; z-index: 1;
      margin-bottom: 80px;
    }
    .btn-primary {
      background: var(--gray-900); color: #fff;
      padding: 0.9rem 2rem; border-radius: 100px;
      font-size: 0.95rem; font-weight: 500;
      text-decoration: none;
      transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 2px 20px rgba(0,0,0,0.15);
    }
    .btn-primary:hover { background: var(--gray-700); transform: scale(1.02); box-shadow: 0 4px 30px rgba(0,0,0,0.2); }
    .btn-secondary {
      background: var(--gray-50); color: var(--gray-700);
      padding: 0.9rem 2rem; border-radius: 100px;
      font-size: 0.95rem; font-weight: 500;
      text-decoration: none; border: 1px solid var(--gray-100);
      transition: background 0.2s, transform 0.2s;
    }
    .btn-secondary:hover { background: var(--gray-100); transform: scale(1.02); }
 
    /* Hero stats bar */
    .hero-stats {
      display: flex; gap: 0;
      background: var(--gray-50); border: 1px solid var(--gray-100);
      border-radius: 20px; overflow: hidden;
      position: relative; z-index: 1;
      max-width: 700px; width: 100%;
    }
    .stat {
      flex: 1; padding: 20px 24px; text-align: center;
      border-right: 1px solid var(--gray-100);
    }
    .stat:last-child { border-right: none; }
    .stat-num {
      font-size: 1.6rem; font-weight: 600; color: var(--gray-900);
      line-height: 1; margin-bottom: 4px;
    }
    .stat-label { font-size: 0.75rem; color: var(--gray-500); }
 
    /* ── MARQUEE ── */
    .marquee-section {
      padding: 0; overflow: hidden;
      border-top: 1px solid var(--gray-100);
      border-bottom: 1px solid var(--gray-100);
      background: var(--gray-50);
    }
    .marquee-track {
      display: flex; gap: 0;
      animation: marquee 25s linear infinite;
      width: max-content;
    }
    .marquee-item {
      display: flex; align-items: center; gap: 10px;
      padding: 14px 32px; white-space: nowrap;
      font-size: 0.85rem; font-weight: 500; color: var(--gray-500);
      border-right: 1px solid var(--gray-100);
    }
    .marquee-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent2); flex-shrink: 0; }
    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
 
    /* ── LEISTUNGEN ── */
    #leistungen { background: var(--white); }
    .leistungen-header { max-width: 600px; margin-bottom: 60px; }
    .leistungen-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px; background: var(--gray-100);
      border-radius: var(--radius); overflow: hidden;
      border: 1px solid var(--gray-100);
    }
    .leistung-card {
      background: var(--white); padding: 36px 32px;
      transition: background var(--transition);
      cursor: default;
    }
    .leistung-card:hover { background: var(--gray-50); }
    .leistung-icon {
      font-size: 1.8rem; margin-bottom: 20px; display: block;
    }
    .leistung-card h3 {
      font-size: 1.05rem; font-weight: 600;
      color: var(--gray-900); margin-bottom: 10px;
    }
    .leistung-card p { font-size: 0.875rem; color: var(--gray-500); line-height: 1.65; }
 
    /* ── SCROLL FEATURE ── */
    #feature {
      background: var(--gray-50);
      overflow: hidden; position: relative;
    }
    #feature .label { color: var(--accent); }
    #feature h2 { color: var(--gray-900); }
    .feature-inner {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 80px; align-items: start;
    }
    .feature-sticky {
      position: sticky; top: 120px;
    }
    .feature-sticky .subtitle { color: var(--gray-500); max-width: 400px; }
    .feature-items { display: flex; flex-direction: column; gap: 2px; }
    .feature-item {
      padding: 28px 32px;
      border-radius: var(--radius);
      background: var(--white);
      border: 1px solid var(--gray-100);
      transition: background var(--transition), border-color var(--transition), transform var(--transition);
      cursor: default;
    }
    .feature-item:hover {
      background: var(--gray-50);
      border-color: var(--accent2);
      transform: translateX(6px);
    }
    .feature-item-num {
      font-size: 0.7rem; font-weight: 600; color: var(--accent);
      letter-spacing: 0.1em; margin-bottom: 10px;
    }
    .feature-item h3 {
      font-size: 1.05rem; font-weight: 600; color: var(--gray-900);
      margin-bottom: 8px;
    }
    .feature-item p { font-size: 0.875rem; color: var(--gray-500); line-height: 1.65; }
 
    /* ── PROZESS ── */
    #prozess { background: var(--gray-50); }
    .prozess-header { max-width: 600px; margin-bottom: 60px; }
    .prozess-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 2px; background: var(--gray-100);
      border-radius: var(--radius); overflow: hidden;
      border: 1px solid var(--gray-100);
    }
    .prozess-step {
      background: var(--white); padding: 36px 28px;
      position: relative;
      transition: background var(--transition);
    }
    .prozess-step:hover { background: var(--gray-50); }
    .step-num {
      font-size: 2.5rem; font-weight: 600;
      color: var(--gray-100); line-height: 1;
      margin-bottom: 16px;
    }
    .prozess-step h3 {
      font-size: 0.95rem; font-weight: 600;
      color: var(--gray-900); margin-bottom: 8px;
    }
    .prozess-step p { font-size: 0.825rem; color: var(--gray-500); line-height: 1.65; }
 
    /* ── PREISE ── */
    #preise { background: var(--white); }
    .preise-header { max-width: 600px; margin-bottom: 60px; }
    .preise-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .preis-card {
      border: 1px solid var(--gray-100); border-radius: var(--radius);
      padding: 36px 32px; background: var(--white);
      transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
    }
    .preis-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.08);
      border-color: var(--gray-300);
    }
    .preis-card.featured {
      background: var(--gray-900); border-color: var(--gray-900);
    }
    .preis-card.featured:hover { border-color: var(--gray-700); }
    .preis-badge {
      display: inline-block; background: var(--accent); color: #fff;
      font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em;
      padding: 0.2rem 0.7rem; border-radius: 100px;
      margin-bottom: 20px; text-transform: uppercase;
    }
    .preis-card h3 {
      font-size: 1.1rem; font-weight: 600;
      color: var(--gray-900); margin-bottom: 6px;
    }
    .preis-card.featured h3 { color: var(--white); }
    .preis-desc { font-size: 0.825rem; color: var(--gray-500); margin-bottom: 24px; line-height: 1.5; }
    .preis-card.featured .preis-desc { color: rgba(255,255,255,0.45); }
    .preis-amount {
      font-size: 2.8rem; font-weight: 600; color: var(--gray-900);
      line-height: 1; margin-bottom: 4px;
    }
    .preis-amount span { font-size: 1.1rem; font-weight: 400; }
    .preis-card.featured .preis-amount { color: var(--white); }
    .preis-note { font-size: 0.75rem; color: var(--gray-500); margin-bottom: 28px; }
    .preis-card.featured .preis-note { color: rgba(255,255,255,0.35); }
    .preis-divider { height: 1px; background: var(--gray-100); margin-bottom: 24px; }
    .preis-card.featured .preis-divider { background: rgba(255,255,255,0.1); }
    .preis-features { list-style: none; display: flex; flex-direction: column; gap: 12px; }
    .preis-features li {
      font-size: 0.875rem; color: var(--gray-700);
      display: flex; align-items: flex-start; gap: 10px; line-height: 1.4;
    }
    .preis-features li::before {
      content: ''; width: 16px; height: 16px; border-radius: 50%;
      background: var(--accent-light); flex-shrink: 0;
      background-image: url("data:image/svg+xml,%3Csvg width='10' height='8' viewBox='0 0 10 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4L3.5 6.5L9 1' stroke='%232D6A4F' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat; background-position: center;
      margin-top: 1px;
    }
    .preis-card.featured .preis-features li { color: rgba(255,255,255,0.7); }
    .preis-card.featured .preis-features li::before {
      background-color: rgba(82,183,136,0.15);
      background-image: url("data:image/svg+xml,%3Csvg width='10' height='8' viewBox='0 0 10 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4L3.5 6.5L9 1' stroke='%2352B788' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    }
    .preis-cta {
      display: block; text-align: center;
      margin-top: 28px; padding: 0.8rem;
      border-radius: 12px; font-size: 0.875rem; font-weight: 500;
      text-decoration: none; transition: background 0.2s, transform 0.15s;
      background: var(--gray-50); color: var(--gray-900);
      border: 1px solid var(--gray-100);
    }
    .preis-cta:hover { background: var(--gray-100); transform: scale(1.01); }
    .preis-card.featured .preis-cta {
      background: var(--accent); color: #fff; border-color: transparent;
    }
    .preis-card.featured .preis-cta:hover { background: #245c42; }
 
    /* ── ÜBER ── */
    #ueber { background: var(--gray-50); }
    .ueber-inner {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: clamp(40px, 6vw, 100px); align-items: center;
    }
    .ueber-text .subtitle { margin-bottom: 32px; }
    .ueber-text p {
      font-size: 0.975rem; color: var(--gray-500); line-height: 1.8;
      margin-bottom: 16px;
    }
    .ueber-text p strong { color: var(--gray-900); font-weight: 500; }
    .exp-list { display: flex; flex-direction: column; gap: 16px; margin-top: 32px; }
    .exp-item {
      display: flex; align-items: center; gap: 16px;
      padding: 16px 20px; background: var(--white);
      border: 1px solid var(--gray-100); border-radius: 14px;
      transition: border-color 0.2s, transform 0.2s;
    }
    .exp-item:hover { border-color: var(--accent2); transform: translateX(4px); }
    .exp-num {
      font-size: 1.3rem; font-weight: 600; color: var(--accent);
      min-width: 44px;
    }
    .exp-text { font-size: 0.875rem; color: var(--gray-700); line-height: 1.4; }
    .ueber-statement {
      padding: 28px; background: var(--white);
      border: 1px solid var(--gray-100); border-radius: var(--radius);
      margin-top: 24px;
    }
    .ueber-statement p {
      font-size: 0.975rem; color: var(--gray-700); line-height: 1.7;
      font-weight: 500; margin-bottom: 12px;
    }
    .ueber-statement span { font-size: 0.8rem; color: var(--gray-500); }
    .tag-cloud { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
    .tag {
      background: var(--white); border: 1px solid var(--gray-100);
      color: var(--gray-700); padding: 0.35rem 0.9rem;
      border-radius: 100px; font-size: 0.78rem; font-weight: 500;
      transition: border-color 0.2s, color 0.2s;
    }
    .tag:hover { border-color: var(--accent2); color: var(--accent); }
 
    /* ── FAQ ── */
    #faq { background: var(--white); }
    .faq-header { max-width: 600px; margin-bottom: 60px; }
    .faq-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 2px; background: var(--gray-100);
      border-radius: var(--radius); overflow: hidden;
      border: 1px solid var(--gray-100); max-width: 960px;
    }
    .faq-item {
      background: var(--white); padding: 0;
      cursor: pointer; transition: background 0.2s;
    }
    .faq-item:hover { background: var(--gray-50); }
    .faq-question {
      display: flex; align-items: center; justify-content: space-between;
      padding: 24px 28px; gap: 16px;
    }
    .faq-question span {
      font-size: 0.925rem; font-weight: 500; color: var(--gray-900); line-height: 1.4;
    }
    .faq-icon {
      width: 28px; height: 28px; border-radius: 50%;
      background: var(--gray-50); border: 1px solid var(--gray-100);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; font-size: 1rem; color: var(--gray-500);
      transition: background 0.2s, transform 0.3s;
    }
    .faq-item.open .faq-icon { background: var(--accent); color: #fff; transform: rotate(45deg); }
    .faq-answer {
      padding: 0 28px; max-height: 0; overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), padding 0.3s;
      font-size: 0.875rem; color: var(--gray-500); line-height: 1.7;
    }
    .faq-item.open .faq-answer { max-height: 300px; padding-bottom: 24px; }
 
    /* ── KONTAKT ── */
    #kontakt { background: var(--gray-50); }
    #kontakt .label { color: var(--accent); }
    .kontakt-header { max-width: 600px; margin-bottom: 60px; }
    .kontakt-header h2 { color: var(--gray-900); }
    .kontakt-header .subtitle { color: var(--gray-500); }
    .kontakt-inner {
      display: grid; grid-template-columns: 1fr 1.4fr;
      gap: clamp(40px, 6vw, 80px);
    }
    .kontakt-info-block {
      display: flex; flex-direction: column; gap: 16px;
    }
    .kontakt-info-item {
      display: flex; align-items: flex-start; gap: 14px;
      padding: 20px; background: var(--white);
      border: 1px solid var(--gray-100);
      border-radius: 14px; transition: background 0.2s, border-color 0.2s;
    }
    .kontakt-info-item:hover { background: var(--gray-50); border-color: var(--accent2); }
    .kontakt-info-icon {
      width: 36px; height: 36px; border-radius: 10px;
      background: var(--accent-light);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem; flex-shrink: 0;
    }
    .kontakt-info-text p:first-child { font-size: 0.75rem; color: var(--gray-500); margin-bottom: 3px; }
    .kontakt-info-text a, .kontakt-info-text p:last-child {
      font-size: 0.9rem; color: var(--gray-900);
      text-decoration: none; font-weight: 500;
    }
    .kontakt-info-text a:hover { color: var(--accent2); }
    .whatsapp-btn {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      background: #25D366; color: #fff;
      padding: 0.9rem 1.5rem; border-radius: 14px;
      font-size: 0.9rem; font-weight: 500;
      text-decoration: none; margin-top: 8px;
      transition: background 0.2s, transform 0.15s;
    }
    .whatsapp-btn:hover { background: #20ba5a; transform: scale(1.02); }
    .kontakt-form { display: flex; flex-direction: column; gap: 12px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group label { font-size: 0.75rem; color: var(--gray-500); letter-spacing: 0.04em; }
    .form-group input,
    .form-group textarea,
    .form-group select {
      background: var(--white);
      border: 1px solid var(--gray-100);
      border-radius: 12px; padding: 0.8rem 1rem;
      color: var(--gray-900); font-family: var(--ff); font-size: 0.875rem;
      outline: none; transition: border-color 0.2s, background 0.2s; width: 100%;
    }
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
      border-color: var(--accent2);
      background: var(--white);
    }
    .form-group textarea { resize: vertical; min-height: 120px; }
    .form-group select option { background: var(--white); color: var(--gray-900); }
    .form-submit {
      background: var(--accent); color: #fff; border: none;
      border-radius: 12px; padding: 0.9rem 2rem;
      font-size: 0.9rem; font-weight: 500; font-family: var(--ff);
      cursor: pointer; transition: background 0.2s, transform 0.15s;
      align-self: flex-start;
    }
    .form-submit:hover { background: #245c42; transform: scale(1.02); }
 
    /* ── FOOTER ── */
    footer {
      background: var(--gray-900);
      border-top: 1px solid rgba(255,255,255,0.08);
      padding: 28px max(24px, 5vw);
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 12px;
    }
    footer p { font-size: 0.78rem; color: rgba(255,255,255,0.3); }
    .footer-links { display: flex; gap: 20px; }
    .footer-links a {
      font-size: 0.78rem; color: rgba(255,255,255,0.3);
      text-decoration: none; transition: color 0.2s;
    }
    .footer-links a:hover { color: var(--accent2); }
 
    /* ── MODALS ── */
    .modal-overlay {
      display: none; position: fixed; inset: 0; z-index: 1000;
      background: rgba(0,0,0,0.6); backdrop-filter: blur(8px);
      align-items: center; justify-content: center; padding: 24px;
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: var(--white); border-radius: 24px;
      max-width: 680px; width: 100%; max-height: 80vh;
      overflow-y: auto; padding: 48px;
      position: relative;
      animation: modalIn 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(20px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .modal-close {
      position: absolute; top: 20px; right: 20px;
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--gray-50); border: 1px solid var(--gray-100);
      cursor: pointer; font-size: 1.1rem; color: var(--gray-500);
      display: flex; align-items: center; justify-content: center;
      transition: background 0.2s;
    }
    .modal-close:hover { background: var(--gray-100); }
    .modal h2 { font-size: 1.6rem; margin-bottom: 8px; }
    .modal .modal-date { font-size: 0.8rem; color: var(--gray-500); margin-bottom: 28px; }
    .modal h3 { font-size: 1rem; font-weight: 600; margin: 24px 0 8px; color: var(--gray-900); }
    .modal p, .modal li {
      font-size: 0.875rem; color: var(--gray-500); line-height: 1.75;
    }
    .modal ul { padding-left: 20px; margin-top: 8px; }
    .modal li { margin-bottom: 6px; }
    .modal a { color: var(--accent); }
 
 
    /* ── BLOG ── */
    #blog { background: var(--white); }
    .blog-header { max-width: 600px; margin-bottom: 60px; }
    .blog-grid {
      display: grid; grid-template-columns: 1.5fr 1fr 1fr;
      gap: 16px;
    }
    .blog-card {
      border: 1px solid var(--gray-100); border-radius: var(--radius);
      overflow: hidden; background: var(--white);
      transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
      cursor: pointer;
      text-decoration: none; display: block; color: inherit;
    }
    .blog-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.08);
      border-color: var(--gray-300);
    }
    .blog-card-image {
      height: 180px; display: flex; align-items: center; justify-content: center;
      font-size: 2.5rem;
    }
    .blog-card.featured .blog-card-image { height: 240px; font-size: 3.5rem; }
    .blog-card-body { padding: 24px; }
    .blog-card-tag {
      display: inline-block; font-size: 0.7rem; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--accent); background: var(--accent-light);
      padding: 0.2rem 0.6rem; border-radius: 100px;
      margin-bottom: 12px;
    }
    .blog-card h3 {
      font-size: 1rem; font-weight: 600; color: var(--gray-900);
      line-height: 1.35; margin-bottom: 8px;
    }
    .blog-card.featured h3 { font-size: 1.2rem; }
    .blog-card p {
      font-size: 0.825rem; color: var(--gray-500); line-height: 1.65;
      margin-bottom: 16px;
    }
    .blog-card-meta { font-size: 0.75rem; color: var(--gray-300); }
    .blog-modal-content { display: none; }
 
    /* Blog post modal */
    .blog-post h2 { font-size: 1.6rem; margin-bottom: 8px; }
    .blog-post .post-meta { font-size: 0.8rem; color: var(--gray-500); margin-bottom: 32px; }
    .blog-post h3 { font-size: 1.05rem; font-weight: 600; color: var(--gray-900); margin: 28px 0 10px; }
    .blog-post p { font-size: 0.9rem; color: var(--gray-700); line-height: 1.8; margin-bottom: 16px; }
    .blog-post ul { padding-left: 20px; margin-bottom: 16px; }
    .blog-post li { font-size: 0.9rem; color: var(--gray-700); line-height: 1.8; margin-bottom: 6px; }
 
 
    /* ── DOWNLOADS ── */
    #downloads { background: var(--gray-50); }
    .downloads-header { max-width: 600px; margin-bottom: 48px; }
    .downloads-grid {
      display: flex; flex-direction: column; gap: 2px;
      border-radius: var(--radius); overflow: hidden;
      border: 1px solid var(--gray-100); background: var(--gray-100);
      max-width: 780px;
    }
    .download-item {
      display: flex; align-items: center; justify-content: space-between;
      gap: 20px; padding: 20px 24px;
      background: var(--white);
      transition: background var(--transition);
    }
    .download-item:hover { background: var(--gray-50); }
    .download-left { display: flex; align-items: center; gap: 16px; }
    .download-icon {
      width: 44px; height: 44px; border-radius: 12px;
      background: var(--accent-light);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.2rem; flex-shrink: 0;
    }
    .download-info h4 {
      font-size: 0.925rem; font-weight: 600;
      color: var(--gray-900); margin-bottom: 3px;
    }
    .download-info p {
      font-size: 0.78rem; color: var(--gray-500);
    }
    .download-btn {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--gray-900); color: #fff;
      padding: 0.5rem 1.1rem; border-radius: 100px;
      font-size: 0.8rem; font-weight: 500;
      text-decoration: none; flex-shrink: 0;
      transition: background 0.2s, transform 0.15s;
    }
    .download-btn:hover { background: var(--gray-700); transform: scale(1.02); }
    .download-btn svg { width: 13px; height: 13px; fill: #fff; }
 
    /* ── SCROLL ANIMATIONS ── */
    .fade-up {
      opacity: 0; transform: translateY(32px);
      transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                  transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .fade-up.visible { opacity: 1; transform: translateY(0); }
 
    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      .leistungen-grid { grid-template-columns: 1fr 1fr; }
      .prozess-grid { grid-template-columns: 1fr 1fr; }
      .preise-grid { grid-template-columns: 1fr; max-width: 420px; }
      .feature-inner { grid-template-columns: 1fr; }
      .feature-sticky { position: relative; top: auto; }
      .ueber-inner { grid-template-columns: 1fr; }
      .kontakt-inner { grid-template-columns: 1fr; }
      .faq-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .nav-links { display: none; }
      .leistungen-grid { grid-template-columns: 1fr; }
      .prozess-grid { grid-template-columns: 1fr; }
      .form-row { grid-template-columns: 1fr; }
      .hero-stats { flex-direction: column; border-radius: 16px; }
      .stat { border-right: none; border-bottom: 1px solid var(--gray-100); }
      .stat:last-child { border-bottom: none; }
    }
  </style>
</head>
